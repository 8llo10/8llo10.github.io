# Admin login — keep these ONLY in .env.local / Vercel Environment Variables
ADMIN_USERNAME=ghala
ADMIN_PASSWORD=change-this-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Supabase project settings (server-side only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=portfolio-images
